{
  "name": "sc2-asset-catalog-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@12.2.2",
  "description": "The SC2 asset catalog, the finders and their shared kit, as npm workspaces.",
  "type": "module",
  "workspaces": [
    "packages/sc2-asset-catalog",
    "packages/sc2-finder-kit",
    "packages/sc2-doodad-finder",
    "packages/sc2-music-finder",
    "packages/sc2-set-finder",
    "packages/sc2-effect-finder"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "smoke": "node scripts/smoke.mjs",
    "check-music-notes": "node scripts/check-music-notes.mjs",
    "test-asks": "turbo run build && node packages/sc2-doodad-finder/dist/cli/test-asks.js",
    "test-music-asks": "turbo run build && node packages/sc2-music-finder/dist/cli/test-asks.js",
    "test-set-asks": "turbo run build && node packages/sc2-set-finder/dist/cli/test-asks.js",
    "test-effect-asks": "turbo run build && node packages/sc2-effect-finder/dist/cli/test-asks.js",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only",
    "release": "turbo run build && changeset publish"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@types/node": "^24.0.0",
    "turbo": "^2.11.13",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
