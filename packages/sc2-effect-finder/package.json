{
  "name": "@team-antioch/sc2-effect-finder",
  "version": "0.4.0",
  "description": "Ask for a StarCraft II effect model in plain words (a purple psionic blast, a blue shield shimmer, burning ground) and get the game's effects that fit: the effect looks narrowed with a keyword search and a local embeddings model, then ranked by Jev.",
  "keywords": [
    "starcraft",
    "sc2",
    "effects",
    "particles",
    "map-editor",
    "galaxy-editor"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TeamAntioch/sc2-asset-catalog.git",
    "directory": "packages/sc2-effect-finder"
  },
  "homepage": "https://github.com/TeamAntioch/sc2-asset-catalog#readme",
  "bugs": "https://github.com/TeamAntioch/sc2-asset-catalog/issues",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@team-antioch/sc2-asset-catalog": "0.4.0",
    "@team-antioch/sc2-finder-kit": "0.4.0"
  }
}
