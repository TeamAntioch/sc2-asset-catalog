{
  "name": "@team-antioch/sc2-doodad-finder",
  "version": "0.1.0",
  "description": "Ask for StarCraft II doodads in plain words and see ranked cards at once: a local page that narrows with a keyword search and a local embeddings model, then ranks with Jev.",
  "keywords": [
    "starcraft",
    "sc2",
    "doodads",
    "map-editor",
    "galaxy-editor"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TeamAntioch/sc2-asset-catalog.git",
    "directory": "packages/sc2-doodad-finder"
  },
  "homepage": "https://github.com/TeamAntioch/sc2-asset-catalog#readme",
  "bugs": "https://github.com/TeamAntioch/sc2-asset-catalog/issues",
  "exports": {
    ".": {
      "types": "./dist/start.d.ts",
      "default": "./dist/start.js"
    },
    "./cli/test-asks.js": null,
    "./*": "./dist/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "sc2-doodad-finder": "bin/sc2-doodad-finder.js"
  },
  "files": [
    "bin",
    "dist",
    "!dist/cli/test-asks.*",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@team-antioch/sc2-asset-catalog": "0.1.0",
    "@typesafe-ai/sdk": "^0.7.0",
    "zod": "^4.0.0"
  }
}
